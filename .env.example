# AetherGrid configuration
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Mode. Exactly one of: demo | paper | live. Default is demo so a fresh
# clone runs with zero Coinbase keys. Live requires MODE=live AND a typed
# confirmation via `aethergrid live --i-understand-the-risk`.
# demo cannot promote directly to live — run paper first.
# ---------------------------------------------------------------------------
MODE=demo
LIVE_CONFIRMED=false

# ---------------------------------------------------------------------------
# Coinbase Advanced Trade (CDP) API
# Create a key at https://portal.cdp.coinbase.com/access/api
# Permissions: VIEW + TRADE only. Never enable Transfer / Withdraw.
# Demo ignores these even if set. Paper uses public market data only.
# Live requires view+trade keys.
# ---------------------------------------------------------------------------
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# Optional path to a PEM / JSON key file instead of the env private key.
# COINBASE_API_KEY_FILE=

# ---------------------------------------------------------------------------
# Optional LLM advisor (SpaceXAI / xAI, OpenAI-compatible).
# Used only to rank pairs and explain reasons. Final numbers always pass
# deterministic validators. If unset, the AI operator is fully deterministic.
# ---------------------------------------------------------------------------
XAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.6

# ---------------------------------------------------------------------------
# Persistence. SQLite by default. Postgres example:
# DATABASE_URL=postgresql+asyncpg://aethergrid:aethergrid@postgres:5432/aethergrid
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/aethergrid.db
DATA_DIR=./data

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
AETHERGRID_EMBED_WORKER=true

# ---------------------------------------------------------------------------
# Hard risk limits (the AI cannot disable these)
# ---------------------------------------------------------------------------
MAX_LIVE_NOTIONAL=500
MAX_BOTS=5
MAX_OPEN_ORDERS_TOTAL=200
MAX_OPEN_ORDERS_PER_BOT=80
MAX_DAILY_REALIZED_LOSS=50
MAX_DRAWDOWN_PCT=0.15
MAX_BASE_INVENTORY_PER_BOT=0
MIN_CASH_RESERVE=0
FLATTEN_ON_KILL=false
KILL_SWITCH_PATH=./data/KILL_SWITCH

# ---------------------------------------------------------------------------
# Demo venue (synthetic market, no network to Coinbase)
# ---------------------------------------------------------------------------
DEMO_QUOTE_BALANCE=10000
DEMO_FEE_BPS=60
DEMO_SEED_ON_BOOT=true

# ---------------------------------------------------------------------------
# Paper venue
# ---------------------------------------------------------------------------
PAPER_QUOTE_BALANCE=100000
PAPER_FEE_BPS=60
PAPER_QUOTE_CURRENCY=USD

# ---------------------------------------------------------------------------
# Operator / market loops
# ---------------------------------------------------------------------------
AI_ENABLED=true
AI_INTERVAL_SECONDS=60
RECONCILE_INTERVAL_SECONDS=15
TICKER_POLL_SECONDS=1.0
LOG_LEVEL=INFO
LOG_JSON=true
